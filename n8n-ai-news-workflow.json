      "id": "7c335ba8-56c7-4c61-9fd7-46749ecc44d0",
      "name": "发送消息"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet content = '';\nfor (const item of items) {\n  const json = item.json;\n  if (json.choices && json.choices.length > 0) {\n    const message = json.choices[0].message;\n    if (message && message.content) {\n      try {\n        let rawContent = message.content.trim();\n        // 去掉开头的 ```json 和结尾的 ```\n        rawContent = rawContent.replace(/^```json\\s*/, '');\n        rawContent = rawContent.replace(/```\\s*$/, '');\n        const parsed = JSON.parse(rawContent);\n        if (Array.isArray(parsed)) {\n          const lines = parsed.map((item, idx) => {\n            return `${idx+1}. 【${item.date || ''}】${item.category || ''} ${item.title || ''}\\n- 发生了什么：${item.event || ''}\\n- 对行业意味着什么：${item.industryImpact || ''}\\n- 对人类生活意味着什么：${item.humanImpact || ''}\\n- 原文链接：${item.link || '暂无'}`;\n          });\n          content += lines.join('\\n\\n') + '\\n\\n';\n        } else {\n          content += message.content + '\\n\\n';\n        }\n      } catch (e) {\n        content += message.content + '\\n\\n';\n      }\n    }\n  }\n}\n\nif (!content.trim()) {\n  return {\n    message: '今日暂无AI新闻。'\n  };\n}\n\nconst safeMessage = content\n  .replace(/\\\\/g, '\\\\\\\\')\n  .replace(/\"/g, '\\\\\"')\n  .replace(/\\n/g, '\\\\n');\n\nreturn {\n  message: safeMessage\n};"
      },

    {
      "parameters": {
        "jsCode": "// 获取 Merge 节点的输入数据\nconst inputData = $input.first().json;\n\n// 从 bodyString 中提取新闻列表（这是一个字符串，需要解析成 JSON）\nconst bodyString = inputData.bodyString;\n// 解析 JSON\nlet parsedBody;\ntry {\n  parsedBody = JSON.parse(bodyString);\n} catch (e) {\n  // 如果解析失败，返回错误信息\n  return {\n    error: '无法解析 bodyString，请检查格式'\n  };\n}\n\n// 提取新闻列表（在 messages[1].content 里）\nconst userContent = parsedBody.messages[1].content;\n\n// 从 userContent 中按 \"标题：\" 和 \"摘要：\" 提取新闻\nconst newsItems = [];\nconst lines = userContent.split('\\n');\nlet currentNews = {};\nfor (const line of lines) {\n  if (line.startsWith('标题：')) {\n    if (currentNews.title) {\n      newsItems.push(currentNews);\n    }\n    currentNews = {\n      title: line.replace('标题：', '').trim(),\n      link: '',\n      summary: '',\n      source: '爱范儿',\n      pubDate: ''\n    };\n  } else if (line.startsWith('摘要：')) {\n    currentNews.summary = line.replace('摘要：', '').trim();\n  } else if (line.startsWith('链接：')) {\n    currentNews.link = line.replace('链接：', '').trim();\n  } else if (line.startsWith('发布时间：')) {\n    currentNews.pubDate = line.replace('发布时间：', '').trim();\n  }\n}\nif (currentNews.title) {\n  newsItems.push(currentNews);\n}\n\n// 取前5条新闻（或者全部）\nconst topNews = newsItems.slice(0, 5);\n\n// 返回带 token 和新闻数据的对象，供多维表格节点使用\nreturn topNews.map(item => ({\n  json: {\n    tenant_access_token: inputData.tenant_access_token,\n    title: item.title,\n    link: item.link,\n    summary: item.summary,\n    source: item.source,\n    pubDate: item.pubDate\n  }\n}));"
      },

    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet rawNews = '';\nfor (const item of items.slice(0, 15)) {\n  const json = item.json;\n  const title = json.title || '无标题';\n  const summary = json.contentsnippet || json.content || '';\n  const link = json.link || '';  // ← 新增：提取链接\n  rawNews += `标题：${title}\\n摘要：${summary}\\n链接：${link}\\n\\n`;  // ← 新增：链接拼进去\n}\n\nconst today = new Date().toISOString().slice(0, 10).replace(/-/g, '');\nconst userContent = `今天是 ${today}。请从今日新闻中筛选出5条对普通人生活有影响的AI/科技动态。保留1-2条有技术深度的内容，其余重点选和日常生活相关的应用（如工具更新、消费方式变化、娱乐新玩法）。\n\n请以 JSON 数组格式输出，每条新闻必须包含以下字段：\n- date（日期，格式为 YYYYMMDD）\n- category（分类，如 AI模型、智能家居、移动支付、手机产业 等）\n- title（标题）\n- event（发生了什么，写清事件、主体、数据）\n- industryImpact（对行业意味着什么，趋势判断）\n- humanImpact（对人类生活意味着什么，写具体场景）\n- link（原文链接，如果没有则填 \"\"）\n\n输出要求：\n- 直接输出 JSON 数组，不要开场白和结束语\n- 不要输出 reasoning_content\n- 不要万能空话\n- 英文新闻翻译成中文\n- 如果筛选出的内容少于5条，有多少条就输出多少条，不要空着。\n\n新闻如下：\\n\\n${rawNews}`;\n\nconst payload = {\n  model: \"deepseek-v4-flash\",\n  max_tokens: 4000,\n  temperature: 0.7,\n  messages: [\n    {\n      role: \"system\",\n      content: \"你是一个新闻筛选器。只选AI/科技相关新闻。不选就业政策、考研、创业补贴、教育制度。\"\n    },\n    {\n      role: \"user\",\n      content: userContent\n    }\n  ]\n};\n\nreturn {\n  bodyString: JSON.stringify(payload)\n};"
      },

        "jsonBody": "={\n    \"fields\": {\n        \"标题\": \"{{ $json.title }}\",\n        \"链接\": \"{{ $json.link }}\",\n        \"摘要\": \"{{ $json.summary }}\",\n        \"来源\": \"{{ $json.source }}\",\n        \"日期\": \"{{ $json.pubDate }}\"\n    }\n}",
